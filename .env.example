# Порт API на хосте
API_PORT=3000

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# S3 (Garage). Ключ и bucket создаются при первом старте контейнера s3.
# S3_ACCESS_KEY_ID: "GK" + 24 hex-символа  -> echo "GK$(openssl rand -hex 12)"
# S3_SECRET_ACCESS_KEY: 64 hex-символа     -> openssl rand -hex 32
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Секрет RPC Garage: 64 hex-символа        -> openssl rand -hex 32
GARAGE_RPC_SECRET=
